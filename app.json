{
  "expo": {
    "name": "HanGo",
    "slug": "HanGo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo/smallScale.jpg",
    "scheme": "hango",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo/smallScale.jpg",
      "infoPlist": {
        "NSCameraUsageDescription": "The app accesses your camera to scan and translate Chinese text.",
        "NSPhotoLibraryUsageDescription": "The app accesses your photos to scan and translate Chinese text."
      }
    },
    "splash": {
      "image": "./assets/images/logo/normalScale.jpg",
      "resizeMode": "contain",
      "backgroundColor": "red"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/logo/smallScale.jpg",
        "backgroundImage": "./assets/images/logo/smallScale.jpg",
        "monochromeImage": "./assets/images/logo/smallScale.jpg"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fareshouidi.HanGo",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo/smallScale.jpg"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to scan and translate Chinese text.",
          "cameraPermission": "The app accesses your camera to scan and translate Chinese text."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2ccab34e-65b0-4293-b208-aa318fd90853"
      }
    }
  }
}

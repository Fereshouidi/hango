{
  "expo": {
    "name": "HanGo",
    "slug": "HanGo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo/smallScale.jpg",
    "scheme": "hango",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo/smallScale.jpg"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo/smallScale.jpg",
        "backgroundImage": "./assets/images/logo/smallScale.jpg",
        "monochromeImage": "./assets/images/logo/smallScale.jpg"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fareshouidi.HanGo",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo/smallScale.jpg"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2ccab34e-65b0-4293-b208-aa318fd90853"
      }
    }
  }
}

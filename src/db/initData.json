  "texts": [
    {
      "id": 1,
      "hskId": 1,
      "lessonId": 1,
      "title": "你好",
      "content": "你好！我叫小明。我是学生。很高兴认识你。",
      "pinyin": "Nǐ hǎo! Wǒ jiào Xiǎomíng. Wǒ shì xuésheng. Hěn gāoxìng rènshi nǐ.",
      "meaning": "Hello! My name is Xiaoming. I am a student. Nice to meet you."
    },
    {
      "id": 2,
      "hskId": 2,
      "lessonId": 2,
      "title": "我喜欢吃苹果",
      "content": "我喜欢吃苹果。苹果很好吃。我每天吃一个苹果。",
      "pinyin": "Wǒ xǐhuan chī píngguǒ. Píngguǒ hěn hǎochī. Wǒ měitiān chī yí ge píngguǒ.",
      "meaning": "I like eating apples. Apples are delicious. I eat an apple every day."
    },
    {
      "id": 3,
      "hskId": 3,
      "lessonId": 3,
      "title": "我是学生",
      "content": "我是一个学生。我每天去学校学习中文和英语。我很喜欢学习新的东西。",
      "pinyin": "Wǒ shì yí ge xuésheng. Wǒ měitiān qù xuéxiào xuéxí Zhōngwén hé Yīngyǔ. Wǒ hěn xǐhuan xuéxí xīn de dōngxi.",
      "meaning": "I am a student. I go to school every day to study Chinese and English. I really like learning new things."
    },
    {
      "id": 4,
      "hskId": 4,
      "lessonId": 4,
      "title": "多少钱？",
      "content": "我想买这个手机。请问，这个手机多少钱？如果太贵了，我可以看看别的吗？",
      "pinyin": "Wǒ xiǎng mǎi zhège shǒujī. Qǐngwèn, zhège shǒujī duōshao qián? Rúguǒ tài guì le, wǒ kěyǐ kànkan bié de ma?",
      "meaning": "I want to buy this phone. Excuse me, how much is this phone? If it is too expensive, can I look at another one?"
    },
    {
      "id": 5,
      "hskId": 5,
      "lessonId": 5,
      "title": "我会说英语",
      "content": "我会说中文，也会说英语。虽然我的英语还不太好，但是我每天都练习。以后我希望能用英语和更多的人交流。",
      "pinyin": "Wǒ huì shuō Zhōngwén, yě huì shuō Yīngyǔ. Suīrán wǒ de Yīngyǔ hái bú tài hǎo, dànshì wǒ měitiān dōu liànxí. Yǐhòu wǒ xīwàng néng yòng Yīngyǔ hé gèng duō de rén jiāoliú.",
      "meaning": "I can speak Chinese and English. Although my English is not very good yet, I practice every day. In the future, I hope to use English to communicate with more people."
    },
    {
      "id": 6,
      "hskId": 6,
      "lessonId": 6,
      "title": "我想成为一名飞行员",
      "content": "从小开始，我就对飞机很感兴趣。长大以后，我想成为一名飞行员。为了实现这个梦想，我需要认真学习，并且不断提高自己的能力。",
      "pinyin": "Cóng xiǎo kāishǐ, wǒ jiù duì fēijī hěn gǎn xìngqù. Zhǎng dà yǐhòu, wǒ xiǎng chéngwéi yì míng fēixíngyuán. Wèile shíxiàn zhège mèngxiǎng, wǒ xūyào rènzhēn xuéxí, bìngqiě búduàn tígāo zìjǐ de nénglì.",
      "meaning": "Since I was young, I have been very interested in airplanes. When I grow up, I want to become a pilot. To achieve this dream, I need to study seriously and continuously improve my abilities."
    }
  ],

  "texts": [
    {
      "id": 1,
      "hskId": 1,
      "lessonId": 1,
      "title": "认识新朋友",
      "content": "你好！我叫王明。我是学生，很高兴认识你。你叫什么名字？",
      "pinyin": "Nǐ hǎo! Wǒ jiào Wáng Míng. Wǒ shì xuésheng, hěn gāoxìng rènshi nǐ. Nǐ jiào shénme míngzi?",
      "meaning": "Hello! My name is Wang Ming. I am a student. Nice to meet you. What is your name?"
    },
    {
      "id": 2,
      "hskId": 1,
      "lessonId": 1,
      "title": "自我介绍",
      "content": "大家好！我叫李华。我是中国人。我住在北京。",
      "pinyin": "Dàjiā hǎo! Wǒ jiào Lǐ Huá. Wǒ shì Zhōngguó rén. Wǒ zhù zài Běijīng.",
      "meaning": "Hello, everyone! My name is Li Hua. I am Chinese. I live in Beijing."
    },
    {
      "id": 3,
      "hskId": 1,
      "lessonId": 1,
      "title": "问候老师",
      "content": "老师好！我叫张伟。请问您贵姓？",
      "pinyin": "Lǎoshī hǎo! Wǒ jiào Zhāng Wěi. Qǐngwèn nín guìxìng?",
      "meaning": "Hello, teacher! My name is Zhang Wei. May I ask your family name?"
    },
    {
      "id": 4,
      "hskId": 1,
      "lessonId": 2,
      "title": "感谢朋友",
      "content": "谢谢你帮助我。不客气。我很高兴。",
      "pinyin": "Xièxie nǐ bāngzhù wǒ. Bú kèqi. Wǒ hěn gāoxìng.",
      "meaning": "Thank you for helping me. You’re welcome. I’m very happy."
    },
    {
      "id": 5,
      "hskId": 1,
      "lessonId": 2,
      "title": "对不起",
      "content": "对不起，我来晚了。没关系。",
      "pinyin": "Duìbuqǐ, wǒ lái wǎn le. Méi guānxi.",
      "meaning": "Sorry, I’m late. That’s all right."
    },
    {
      "id": 6,
      "hskId": 1,
      "lessonId": 2,
      "title": "再见",
      "content": "我走了。再见！明天见。",
      "pinyin": "Wǒ zǒu le. Zàijiàn! Míngtiān jiàn.",
      "meaning": "I’m leaving. Goodbye! See you tomorrow."
    },
    {
      "id": 7,
      "hskId": 1,
      "lessonId": 3,
      "title": "喜欢吃什么",
      "content": "你喜欢吃什么？我喜欢吃苹果。苹果很好吃。",
      "pinyin": "Nǐ xǐhuan chī shénme? Wǒ xǐhuan chī píngguǒ. Píngguǒ hěn hǎochī.",
      "meaning": "What do you like to eat? I like apples. Apples taste good."
    },
    {
      "id": 8,
      "hskId": 1,
      "lessonId": 3,
      "title": "喝茶还是喝咖啡",
      "content": "你喝茶还是喝咖啡？我喝茶。茶很香。",
      "pinyin": "Nǐ hē chá háishi hē kāfēi? Wǒ hē chá. Chá hěn xiāng.",
      "meaning": "Would you like tea or coffee? I’ll have tea. The tea smells nice."
    },
    {
      "id": 9,
      "hskId": 1,
      "lessonId": 3,
      "title": "我想吃米饭",
      "content": "我饿了。我想吃米饭和菜。",
      "pinyin": "Wǒ è le. Wǒ xiǎng chī mǐfàn hé cài.",
      "meaning": "I’m hungry. I want to eat rice and vegetables."
    },
    {
      "id": 10,
      "hskId": 2,
      "lessonId": 4,
      "title": "去超市",
      "content": "你去哪儿？我去超市。超市里有很多东西。",
      "pinyin": "Nǐ qù nǎr? Wǒ qù chāoshì. Chāoshì lǐ yǒu hěn duō dōngxi.",
      "meaning": "Where are you going? I’m going to the supermarket. There are many things in the supermarket."
    },
    {
      "id": 11,
      "hskId": 2,
      "lessonId": 4,
      "title": "坐地铁",
      "content": "我坐地铁去公司。地铁很快。",
      "pinyin": "Wǒ zuò dìtiě qù gōngsī. Dìtiě hěn kuài.",
      "meaning": "I take the subway to work. The subway is fast."
    },
    {
      "id": 12,
      "hskId": 2,
      "lessonId": 4,
      "title": "走路回家",
      "content": "学校离我家很近。我走路回家。",
      "pinyin": "Xuéxiào lí wǒ jiā hěn jìn. Wǒ zǒulù huí jiā.",
      "meaning": "The school is close to my home. I walk home."
    },
    {
      "id": 13,
      "hskId": 2,
      "lessonId": 5,
      "title": "今天天气",
      "content": "今天天气很好。太阳出来了。我们去公园吧。",
      "pinyin": "Jīntiān tiānqì hěn hǎo. Tàiyáng chūlái le. Wǒmen qù gōngyuán ba.",
      "meaning": "The weather is very nice today. The sun has come out. Let’s go to the park."
    },
    {
      "id": 14,
      "hskId": 2,
      "lessonId": 5,
      "title": "下雨了",
      "content": "外面下雨了。带伞吧。",
      "pinyin": "Wàimiàn xià yǔ le. Dài sǎn ba.",
      "meaning": "It’s raining outside. Take an umbrella."
    },
    {
      "id": 15,
      "hskId": 2,
      "lessonId": 5,
      "title": "天气预报",
      "content": "明天会下雪。天气很冷。多穿衣服。",
      "pinyin": "Míngtiān huì xià xuě. Tiānqì hěn lěng. Duō chuān yīfu.",
      "meaning": "It will snow tomorrow. The weather is cold. Wear more clothes."
    },
    {
      "id": 16,
      "hskId": 2,
      "lessonId": 6,
      "title": "买衣服",
      "content": "这件衣服多少钱？五十块。太贵了。便宜一点吧。",
      "pinyin": "Zhè jiàn yīfu duōshao qián? Wǔshí kuài. Tài guì le. Piányi yīdiǎn ba.",
      "meaning": "How much is this piece of clothing? Fifty yuan. It’s too expensive. Could you make it a little cheaper?"
    },
    {
      "id": 17,
      "hskId": 2,
      "lessonId": 6,
      "title": "试衣服",
      "content": "我可以试试吗？当然可以。这件很漂亮。",
      "pinyin": "Wǒ kěyǐ shìshi ma? Dāngrán kěyǐ. Zhè jiàn hěn piàoliang.",
      "meaning": "May I try it on? Of course. This one is beautiful."
    },
    {
      "id": 18,
      "hskId": 2,
      "lessonId": 6,
      "title": "付钱",
      "content": "我买这件。刷卡还是现金？刷卡。",
      "pinyin": "Wǒ mǎi zhè jiàn. Shuākǎ háishi xiànjīn? Shuākǎ.",
      "meaning": "I’ll buy this one. Would you like to pay by card or in cash? By card."
    },
    {
      "id": 19,
      "hskId": 3,
      "lessonId": 7,
      "title": "怎么去学校",
      "content": "你怎么去学校？我坐公共汽车。公共汽车很方便。",
      "pinyin": "Nǐ zěnme qù xuéxiào? Wǒ zuò gōnggòng qìchē. Gōnggòng qìchē hěn fāngbiàn.",
      "meaning": "How do you get to school? I take the bus. The bus is convenient."
    },
    {
      "id": 20,
      "hskId": 3,
      "lessonId": 7,
      "title": "骑自行车",
      "content": "他每天骑自行车上班。既健康又环保。",
      "pinyin": "Tā měitiān qí zìxíngchē shàngbān. Jì jiànkāng yòu huánbǎo.",
      "meaning": "He rides a bicycle to work every day. It is both healthy and environmentally friendly."
    },
    {
      "id": 21,
      "hskId": 3,
      "lessonId": 7,
      "title": "打车",
      "content": "太晚了，我们打车回家吧。好的。",
      "pinyin": "Tài wǎn le, wǒmen dǎchē huí jiā ba. Hǎo de.",
      "meaning": "It’s too late. Let’s take a taxi home. Okay."
    },
    {
      "id": 22,
      "hskId": 3,
      "lessonId": 8,
      "title": "我感冒了",
      "content": "我感冒了，头疼，还有点发烧。你应该去医院。",
      "pinyin": "Wǒ gǎnmào le, tóu téng, hái yǒudiǎn fāshāo. Nǐ yīnggāi qù yīyuàn.",
      "meaning": "I have a cold, a headache, and a slight fever. You should go to the hospital."
    },
    {
      "id": 23,
      "hskId": 3,
      "lessonId": 8,
      "title": "看医生",
      "content": "医生让我多休息，多喝水。我开了药。",
      "pinyin": "Yīshēng ràng wǒ duō xiūxi, duō hē shuǐ. Wǒ kāi le yào.",
      "meaning": "The doctor told me to rest more and drink more water. The doctor prescribed some medicine."
    },
    {
      "id": 24,
      "hskId": 3,
      "lessonId": 8,
      "title": "请假",
      "content": "老师，我生病了，想请假一天。好的，早点好起来。",
      "pinyin": "Lǎoshī, wǒ shēngbìng le, xiǎng qǐngjià yī tiān. Hǎo de, zǎodiǎn hǎo qǐlái.",
      "meaning": "Teacher, I’m sick and would like to take one day off. All right. I hope you feel better soon."
    },
    {
      "id": 25,
      "hskId": 3,
      "lessonId": 9,
      "title": "计划旅行",
      "content": "下个月我想去旅行。你想去哪儿？我想去上海。",
      "pinyin": "Xià ge yuè wǒ xiǎng qù lǚxíng. Nǐ xiǎng qù nǎr? Wǒ xiǎng qù Shànghǎi.",
      "meaning": "I want to travel next month. Where would you like to go? I want to go to Shanghai."
    },
    {
      "id": 26,
      "hskId": 3,
      "lessonId": 9,
      "title": "订机票",
      "content": "我们先订机票吧。网上订比较便宜。",
      "pinyin": "Wǒmen xiān dìng jīpiào ba. Wǎngshàng dìng bǐjiào piányi.",
      "meaning": "Let’s book the plane tickets first. Booking online is cheaper."
    },
    {
      "id": 27,
      "hskId": 3,
      "lessonId": 9,
      "title": "准备行李",
      "content": "旅行前要准备好行李。别忘了带护照。",
      "pinyin": "Lǚxíng qián yào zhǔnbèi hǎo xíngli. Bié wàng le dài hùzhào.",
      "meaning": "Get your luggage ready before the trip. Don’t forget to bring your passport."
    }
  ],
